# Example local Docker defaults. Do not put real API keys in this file.
COMPOSE_PROJECT_NAME=insta_backtester_local

BACKEND_PORT=8000
FRONTEND_PORT=5173
MCP_PORT=8001
METABASE_PORT=3000
ANALYTICS_DB_PORT=5433

POSTGRES_ANALYTICS_DB=analytics
POSTGRES_ANALYTICS_WRITER_USER=analytics_writer
POSTGRES_ANALYTICS_WRITER_PASSWORD=analytics_writer_password
POSTGRES_ANALYTICS_READER_USER=metabase_reader
POSTGRES_ANALYTICS_READER_PASSWORD=metabase_reader_password

POSTGRES_METABASE_DB=metabase
POSTGRES_METABASE_USER=metabase_user
POSTGRES_METABASE_PASSWORD=metabase_password

DEFAULT_CHAT_URL=https://api.openai.com/v1
DEFAULT_CHAT_MODEL=gpt-4o-mini

MCP_SERVER_URL=http://mcp:8001/mcp
METABASE_URL=http://localhost:3000

OPENAI_API_KEY=
FINNHUB_API_KEY=
