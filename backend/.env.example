# Safe template only. Put real credentials in backend/.env, which is ignored.
DJANGO_SECRET_KEY=change-me-for-deployment
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=qfsplatform.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://qfsplatform.com
DJANGO_CORS_ALLOWED_ORIGINS=https://qfsplatform.com
PUBLIC_BACKEND_BASE_URL=https://qfsplatform.com/insta_backtester
APP_BASE_PATH=/insta_backtester/

MCP_ENABLED=true
MCP_TRANSPORT=streamable_http
MCP_SERVER_URL=https://qfsplatform.com/insta_backtest_MCP_server/mcp
MCP_CALL_TIMEOUT_SECONDS=120
MCP_DEFAULT_TOOL=run_strategy_research
MCP_ALLOWED_TOOLS=run_strategy_research,run_markowitz_optimization,construct_factor_portfolio,list_strategies,get_strategy_schema,list_indicators,get_indicator_info,list_stock_universe,list_sectors,list_stocks_by_sector,resolve_symbols_for_sector

# Optional. Enable only after setting a real key in your untracked .env.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finance-mcp-dev

DEFAULT_CHAT_URL=https://api.openai.com/v1
DEFAULT_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
FINNHUB_API_KEY=
